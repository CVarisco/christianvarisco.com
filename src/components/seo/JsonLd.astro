---
import type { Lang } from '../../i18n';

interface CaseStudy {
  company: string;
  website: string;
  heroImage: string;
  seo: { title: string; description: string };
  testimonial?: {
    quote: string;
    author: string;
    role: string;
    rating: number;
  };
}

interface Props {
  lang: Lang;
  faqItems?: Array<{ question: string; answer: string }>;
  services?: Array<{ title: string; solution: string }>;
  caseStudy?: CaseStudy;
}

const { lang, faqItems = [], services = [], caseStudy } = Astro.props;

const siteUrl = 'https://christianvarisco.com';

// Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Christian Varisco",
  "jobTitle": "Fractional CTO",
  "description": lang === 'en'
    ? "Christian Varisco is a Fractional CTO in Milan who helps already-live seed/pre-seed startups with post-round execution on product, tech, and team when the CTO is missing/weak or the stack slows development."
    : "Christian Varisco è un Fractional CTO a Milano che aiuta startup seed/pre-seed già live nell’execution post-round su prodotto, tech e team, quando manca un CTO forte o la tech rallenta lo sviluppo.",
  "url": siteUrl,
  "image": `${siteUrl}/images/brand/christian-varisco.jpg`,
  "sameAs": [
    "https://www.linkedin.com/in/christianvarisco/",
    "https://twitter.com/ChriVarisco",
    "https://github.com/CVarisco",
    "https://www.youtube.com/@christianvarisco",
    "https://www.twitch.tv/christian_varisco"
  ],
  "knowsAbout": [
    "Fractional CTO Services",
    "Post-round Execution",
    "Seed and Pre-seed Startups",
    "Technical Leadership",
    "Product Strategy",
    "Team Building",
    "Software Architecture",
    "Technical Debt",
    "Development Velocity",
    "AI-assisted Delivery",
    "Technology Strategy",
    "Agile Methodologies",
    "Enterprise Architecture",
    "ISO 27001 Compliance",
    "B2B SaaS",
    "HealthTech",
    "HR Tech",
    "Legal Tech",
    "Fintech",
    "AI/ML Integration"
  ],
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "credentialCategory": "Professional Experience",
    "description": "16+ startups assisted, EUR 13M+ raised by clients"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "Christian Varisco Consulting"
  },
  "nationality": {
    "@type": "Country",
    "name": "Italy"
  }
};

// Organization Schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  "name": "Christian Varisco - Fractional CTO Services",
  "url": siteUrl,
  "logo": `${siteUrl}/images/brand/logo.svg`,
  "description": lang === 'en'
    ? "Fractional CTO services in Milan for funded seed and pre-seed startups already in market. Post-round execution across product, tech, and team when there is no strong CTO or the stack slows development: product priorities, technical leadership and hands-on delivery when needed, and team building. 16+ startups assisted; EUR 13M+ raised by clients."
    : "Servizi di Fractional CTO a Milano per startup seed e pre-seed finanziate e già sul mercato. Execution post-round su prodotto, tech e team quando manca un CTO forte o la tech rallenta lo sviluppo: priorità di prodotto, leadership tecnica e delivery hands-on quando serve, e costruzione del team. 16+ startup assistite; EUR 13M+ raccolti dai clienti.",
  "areaServed": ["Italy", "Europe"],
  "priceRange": "$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.95",
    "reviewCount": "10",
    "bestRating": "5"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Fractional CTO Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Product Strategy",
          "description": lang === 'en'
            ? "Set post-round product priorities for already-live seed and pre-seed startups: what to build, what to cut, and in what order."
            : "Definire le priorità di prodotto dopo il round per startup seed e pre-seed già live: cosa costruire, cosa tagliare e in che ordine."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Technical Leadership",
          "description": lang === 'en'
            ? "Lead technical decisions, reduce technical debt, and evolve architecture and engineering practices for faster development. Contribute hands-on, including with AI-assisted delivery, when it unblocks execution."
            : "Guidare le decisioni tecniche, ridurre il debito tecnico e far evolvere architettura e pratiche engineering per velocizzare lo sviluppo. Intervenire hands-on, anche con delivery assistita da AI, quando sblocca l’execution."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Team Building",
          "description": lang === 'en'
            ? "Hire and lead technical talent, clarify team structure, and build autonomous teams that deliver consistently after the round."
            : "Selezionare e guidare talenti tech, chiarire la struttura del team e costruire team autonomi che consegnano con continuità dopo il round."
        }
      }
    ]
  },
  "founder": { "@id": `${siteUrl}/#person` },
  "contactPoint": {
    "@type": "ContactPoint",
    "url": "https://cal.com/christian-varisco/discovery-call",
    "contactType": "customer service",
    "availableLanguage": ["English", "Italian"]
  }
};

// FAQ Schema
const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

// Service Schemas
const serviceSchemas = services.map(service => ({
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": service.title,
  "provider": { "@id": `${siteUrl}/#person` },
  "description": service.solution,
  "areaServed": "Europe"
}));

// WebPage Schema
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": lang === 'en'
    ? "Christian Varisco | Fractional CTO | Italy"
    : "Christian Varisco | Fractional CTO | Italia",
  "description": lang === 'en'
    ? "Christian Varisco is a Fractional CTO in Milan who helps already-live seed/pre-seed startups with post-round execution on product, tech, and team when the CTO is missing/weak or the stack slows development."
    : "Christian Varisco è un Fractional CTO a Milano che aiuta startup seed/pre-seed già live nell’execution post-round su prodotto, tech e team, quando manca un CTO forte o la tech rallenta lo sviluppo.",
  "url": lang === 'en' ? `${siteUrl}/en` : `${siteUrl}/`,
  "inLanguage": lang,
  "isPartOf": {
    "@type": "WebSite",
    "url": siteUrl,
    "name": "Christian Varisco"
  },
  "about": { "@id": `${siteUrl}/#person` },
  "mainEntity": { "@id": `${siteUrl}/#person` }
};

// Case Study Article Schema
const caseStudyArticleSchema = caseStudy ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": caseStudy.seo.title,
  "description": caseStudy.seo.description,
  "image": `${siteUrl}${caseStudy.heroImage}`,
  "author": { "@id": `${siteUrl}/#person` },
  "publisher": { "@id": `${siteUrl}/#organization` },
  "datePublished": new Date().toISOString(),
  "about": {
    "@type": "Organization",
    "name": caseStudy.company,
    "url": caseStudy.website
  }
} : null;

// Case Study Review Schema (from testimonial)
const caseStudyReviewSchema = caseStudy?.testimonial ? {
  "@context": "https://schema.org",
  "@type": "Review",
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": caseStudy.testimonial.rating,
    "bestRating": 5
  },
  "author": {
    "@type": "Person",
    "name": caseStudy.testimonial.author,
    "jobTitle": caseStudy.testimonial.role
  },
  "reviewBody": caseStudy.testimonial.quote,
  "itemReviewed": {
    "@type": "Person",
    "name": "Christian Varisco",
    "url": siteUrl
  }
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{serviceSchemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
{caseStudyArticleSchema && <script type="application/ld+json" set:html={JSON.stringify(caseStudyArticleSchema)} />}
{caseStudyReviewSchema && <script type="application/ld+json" set:html={JSON.stringify(caseStudyReviewSchema)} />}
